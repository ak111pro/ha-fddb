  "exceptions": {
    "no_loaded_entry": {
      "message": "No loaded FDDB account found."
    },
    "multiple_entries": {
      "message": "Several FDDB accounts are set up, choose one."
    },
    "future_date": {
      "message": "The date must not be in the future."
    },
    "refresh_failed": {
      "message": "Reading fddb.info failed: {error}"
    }
