        "config_entry_id": {
          "name": "Account",
          "description": "Only refresh this FDDB account."
        }
      }
    },
    "get_diary": {
      "name": "Get diary",
      "description": "Returns the totals and all products of one day.",
      "fields": {
        "config_entry_id": {
          "name": "Account",
          "description": "FDDB account to read (required if more than one is set up)."
        },
        "date": {
          "name": "Date",
          "description": "Day to read, default today."
        }
      }
    }
